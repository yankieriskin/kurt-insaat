---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import Floor from '../../components/Floor.astro';
import KotMark from '../../components/KotMark.astro';
import Siluet from '../../components/Siluet.astro';
import { projects, stageLabel, forSale, price } from '../../data/site';
const order: Record<string, number> = { insaatta: 0, yakinda: 1, teslim: 2 };
const list = [...projects].sort((a, b) => order[a.stage] - order[b.stage]);
const groups = [
  { id: 'insaatta', name: 'İnşaatta', items: list.filter((p) => p.stage === 'insaatta') },
  { id: 'yakinda', name: 'Yakında', items: list.filter((p) => p.stage === 'yakinda') },
  { id: 'teslim', name: 'Teslim edildi', items: list.filter((p) => p.stage === 'teslim') },
].filter((g) => g.items.length);
const codes = groups.map((_, i) => (groups.length - i === 1 ? 'Z' : String(groups.length - i - 1)));
const kots = groups.map((_, i) => (groups.length - i - 1 === 0 ? '±0.00' : `+${((groups.length - i - 1) * 3).toFixed(2)}`));
---
<Base title="Projeler" description="Kurt İnşaat’ın inşaatı süren, ruhsat bekleyen ve teslim edilen konut projeleri: Kartal, Kadıköy, Maltepe ve Çekmeköy.">
  <Floor id="cati" code="Ç" name="Projeler" kot={`+${(groups.length * 3).toFixed(2)}`} slab={false} class="phead" label="pr-h">
    <div class="wrap g12 pr-head">
      <div class="pr-head__t">
        <p class="phead__kot" aria-hidden="true"><KotMark /><span>+{(groups.length * 3).toFixed(2)}</span></p>
        <h1 id="pr-h" class="display">Projeler</h1>
        <p class="phead__p">Yaptığımız ve yapmakta olduğumuz binalar. Her proje sayfasında daire daire kesit, fiyat, ruhsat ve teslim bilgisi var.</p>
        <ul class="chips pr-chips" aria-label="Duruma göre">
          {groups.map((g) => <li><a class="chip" href={`#${g.id}`}>{g.name}<small>{g.items.length}</small></a></li>)}
        </ul>
      </div>
      <div class="pr-head__s"><Siluet /></div>
    </div>
  </Floor>
  {groups.map((g, gi) => (
    <Floor id={g.id} code={codes[gi]} name={g.name} kot={kots[gi]}>
      <div class="wrap sec--tight">
        <h2 id={`${g.id}-h`} class="h-m" style="margin-bottom:1.4rem">{g.name}</h2>
        <ul class="pcards">
          {g.items.map((p, pi) => (
            <li>
              <a class="pcard" href={`/projeler/${p.slug}/`}>
                <span class="pcard__media"><Image quality={60} format="avif" src={p.cover} alt={p.coverAlt} widths={[560, 900, 1300]} sizes="(max-width: 767px) 100vw, 50vw" loading={gi === 0 ? 'eager' : 'lazy'} fetchpriority={gi === 0 && pi === 0 ? 'high' : undefined} /></span>
                <span class="pcard__body">
                  <span class="pcard__name">{p.name}</span>
                  <span class="pcard__row"><span>{p.neighborhood}, {p.district}</span><span class={`badge badge--${p.stage}`}>{stageLabel[p.stage]}</span></span>
                  <span class="pcard__sum">{p.summary}</span>
                  <span class="pcard__row pcard__row--b">
                    <span>{p.stage === 'teslim' ? `İskân ${p.delivery}` : p.stage === 'yakinda' ? 'Ruhsat bekleniyor' : `Teslim ${p.delivery}`}</span>
                    <span>{forSale(p).length ? `${forSale(p).length} daire satışta, ${price(Math.min(...forSale(p).map((u) => u.price!)))} ile başlıyor` : p.units.length ? 'Hepsi satıldı' : 'Ön kayıt açık'}</span>
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </Floor>
  ))}
</Base>
