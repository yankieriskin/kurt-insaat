---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Floor from '../components/Floor.astro';

import KotMark from '../components/KotMark.astro';
import Icon from '../components/Icon.astro';
import { site, wa, images } from '../data/site';
---
<Base title="İletişim" description={`Kurt İnşaat ofisi: ${site.address.join(', ')}. Telefon ${site.phone.label}, WhatsApp ${site.whatsapp.label}. Hafta içi 09.00 ile 18.30 arası açığız.`}>
  <Floor id="cati" code="Ç" name="İletişim" kot="+3.00" slab={false} class="phead" label="ic-h">
    <div class="wrap g12 ph-grid">
      <div class="ph-grid__t">
        <p class="phead__kot" aria-hidden="true"><KotMark /><span>+3.00</span></p>
        <h1 id="ic-h" class="display">İletişim</h1>
        <p class="phead__p">En hızlı yol WhatsApp. Mesai saatinde bir saat içinde, akşam yazarsanız ertesi sabah dönüyoruz.</p>
      </div>
      <div class="ph-grid__s"><figure class="ph-img"><Image quality={68} src={images.ofisMasa} alt="Ofisteki masa: kesit paftaları, baret, şerit metre" widths={[600, 900]} sizes="(max-width: 1023px) 100vw, 40vw" loading="eager" /></figure></div>
    </div>
  </Floor>
  <Floor id="ofis" code="Z" name="Ofis" kot="±0.00">
    <div class="wrap g12 sec split">
      <div class="split__a">
        <h2 id="ofis-h" class="h-m">Ofis</h2>
        <ul class="acts">
          <li><a class="act act--wa" href={wa('Merhaba, Kurt İnşaat sitesinden yazıyorum.')} target="_blank" rel="noopener"><Icon name="chat" /><span class="act__t">WhatsApp’tan yazın<small>{site.whatsapp.label}</small></span><Icon name="arrow" class="act__go" /><span class="sr-only"> (yeni sekmede açılır)</span></a></li>
          <li><a class="act" href={site.phone.href}><Icon name="phone" /><span class="act__t">Arayın<small>{site.phone.label}</small></span><Icon name="arrow" class="act__go" /></a></li>
          <li><a class="act" href={`mailto:${site.email}`}><Icon name="mail" /><span class="act__t">E-posta<small>{site.email}</small></span><Icon name="arrow" class="act__go" /></a></li>
          <li><a class="act" href={`https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(site.mapQuery)}`} target="_blank" rel="noopener"><Icon name="pin" /><span class="act__t">Yol tarifi<small>{site.address.join(', ')}</small></span><Icon name="arrow" class="act__go" /><span class="sr-only"> (yeni sekmede açılır)</span></a></li>
        </ul>
        <dl class="facts" style="margin-top:1.5rem">
          <dt>Adres</dt><dd>{site.address.join(', ')}</dd>
          {site.hours.map(([d, h]) => <><dt>{d}</dt><dd>{h}</dd></>)}
        </dl>
      </div>
      <div class="split__b">
        <h2 class="h-m" style="margin-bottom:1rem">Sizi arayalım</h2>
        <form class="form" data-wa={site.whatsapp.number} data-msg="Merhaba, beni arayabilir misiniz?">
          <div class="field"><label for="c-ad">Adınız</label><input id="c-ad" name="ad" autocomplete="name" required /></div>
          <div class="field"><label for="c-tel">Telefonunuz</label><input id="c-tel" name="tel" type="tel" inputmode="tel" autocomplete="tel" required /></div>
          <div class="field"><label for="c-konu">Konu</label><select id="c-konu" name="konu"><option>Satılık daire</option><option>Kiralık daire</option><option>Kentsel dönüşüm</option><option>Arsa</option><option>Diğer</option></select></div>
          <div class="field"><label for="c-saat">Uygun saat</label><select id="c-saat" name="saat"><option>Fark etmez</option><option>Sabah</option><option>Öğleden sonra</option><option>Akşam</option></select></div>
          <div class="field full"><label for="c-not">Mesajınız (isteğe bağlı)</label><textarea id="c-not" name="not"></textarea></div>
          <p class="form__note full">Gönder’e bastığınızda WhatsApp açılır ve yazdıklarınız mesaj olarak hazırlanır. Mesajı siz gönderene kadar bize hiçbir bilgi ulaşmaz. Ayrıntı için <a class="ulink" href="/kvkk/">KVKK aydınlatma metni</a>.</p>
          <button class="btn btn--solid btn--md full" type="submit"><span class="btn__label">WhatsApp’ta hazırla ve gönder</span><svg class="btn__arrow" viewBox="0 0 16 16" aria-hidden="true"><path d="M2 8h11M9 4l4 4-4 4" /></svg></button>
          <p class="form__sent full" data-sent hidden>WhatsApp açıldı. Mesajı gönderdiğinizde sizi seçtiğiniz saatte arayacağız.</p>
        </form>
      </div>
    </div>
  </Floor>
</Base>
